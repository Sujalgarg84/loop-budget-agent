# Copy to .env and fill in a real key for live Gemini runs.
# Tests, --mock, and the 50-task benchmark never need this.

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hard caps enforced in code (not only in the prompt)
MAX_STEPS=10
MAX_TOKENS=8000
MAX_COST_USD=0.05
LOOP_REPEAT_THRESHOLD=3

CHECKPOINT_PATH=checkpoints.sqlite
